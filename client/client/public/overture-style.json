{
  "version": 8,
  "sources": {
    "overture": {
      "type": "geojson",
      "data": "/overture.geojson"
    }
  },
  "layers": [
    {
      "id": "overture-fill",
      "type": "fill",
      "source": "overture",
      "paint": {
        "fill-color": [
          "match",
          ["get", "source_type"],
          "my", "#2ecc71",
          "osm", "#3498db",
          "ml", "#e67e22",
          "#808080"
        ],
        "fill-opacity": 0.6
      }
    },
    {
      "id": "overture-outline",
      "type": "line",
      "source": "overture",
      "paint": {
        "line-color": "#222",
        "line-width": 0.5
      }
    }
  ]
}
